# Go build output
/bin/
dist/
*.exe
*.test
*.out

# Generated. go.work itself IS committed — it defines the module layout (ADR-0008).
go.work.sum

# Node — present only for the contract linters (Spectral, AsyncAPI CLI). See the Makefile header.
node_modules/

# Env & secrets (NEVER commit real secrets — use Vault)
.env
.env.*
!.env.example

# Logs
*.log
logs/

# Test / coverage
coverage/
coverage.out
coverage.html

# IDE
.idea/
.vscode/*
!.vscode/extensions.json

# OS
.DS_Store
Thumbs.db

# Terraform
**/.terraform/*
*.tfstate
*.tfstate.*
crash.log
*.tfvars
!*.tfvars.example
override.tf
override.tf.json
