{
  "name": "watercraft-booking",
  "version": "0.0.0",
  "private": true,
  "description": "Booking & rental platform for boats, yachts, and wakesurf sessions — microservices monorepo",
  "engines": {
    "node": ">=22 <23",
    "pnpm": ">=9"
  },
  "packageManager": "pnpm@9.12.0",
  "workspaces": [
    "services/*",
    "shared/*"
  ],
  "scripts": {
    "infra:up": "docker compose -f infra/docker-compose.yml up -d",
    "infra:down": "docker compose -f infra/docker-compose.yml down",
    "infra:logs": "docker compose -f infra/docker-compose.yml logs -f",
    "build": "nx run-many -t build",
    "test": "nx run-many -t test",
    "test:contract": "nx run-many -t test:contract",
    "lint": "nx run-many -t lint",
    "contracts:lint": "pnpm --filter @booking/contracts-tools lint",
    "format": "prettier --write \"**/*.{ts,js,json,yaml,yml,md}\""
  },
  "devDependencies": {
    "@nx/js": "^20.0.0",
    "@nx/nest": "^20.0.0",
    "nx": "^20.0.0",
    "prettier": "^3.3.3",
    "typescript": "^5.6.0"
  }
}
