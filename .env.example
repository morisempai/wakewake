# =============================================================================
# LOCAL DEV ONLY. Real secrets live in Vault — never commit a populated .env.
# Copy to `.env` for `docker compose up`. Values here are safe dev defaults.
# =============================================================================

# --- Postgres (one instance in dev; one DB per service, logically isolated) ---
POSTGRES_USER=booking
POSTGRES_PASSWORD=booking_dev_pw
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# --- Per-service DATABASE_URL (each service owns its own database, root rule #6) ---
# The root docker-compose.yml sets these per service; listed here for running a service standalone.
# The five services listen on :8080 INTERNALLY and publish NO host ports (ADR-0006): every external
# request enters through the gateway on host :8080. Only the gateway, Keycloak (:8088), and the dev
# fixtures (Mailhog :8025, RabbitMQ UI :15672, Grafana :3000, ...) are reachable from the host.
CATALOG_DATABASE_URL=postgres://booking:booking_dev_pw@postgres:5432/catalog?sslmode=disable
AVAILABILITY_DATABASE_URL=postgres://booking:booking_dev_pw@postgres:5432/availability?sslmode=disable
BOOKING_DATABASE_URL=postgres://booking:booking_dev_pw@postgres:5432/booking?sslmode=disable
PAYMENT_DATABASE_URL=postgres://booking:booking_dev_pw@postgres:5432/payment?sslmode=disable
NOTIFICATION_DATABASE_URL=postgres://booking:booking_dev_pw@postgres:5432/notification?sslmode=disable

# --- RabbitMQ ---
RABBITMQ_DEFAULT_USER=booking
RABBITMQ_DEFAULT_PASS=booking_dev_pw
RABBITMQ_URL=amqp://booking:booking_dev_pw@rabbitmq:5672

# --- Keycloak (identity / OIDC) ---
# Host-published on :8088 (the gateway owns :8080). A token minted via the host carries
# iss=http://localhost:8088/realms/booking; the gateway reaches Keycloak internally at keycloak:8080.
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin_dev_pw
KEYCLOAK_REALM=booking
KEYCLOAK_ISSUER_URL=http://keycloak:8080/realms/booking

# --- Gateway (sole ingress: OIDC validation + correlation + rate limiting; ADR-0006, ADR-0012) ---
# OIDC_ISSUER is the exact `iss` a token must carry (the host:port callers log in through).
# OIDC_JWKS_URL is where the gateway fetches signing keys (an address it can actually reach).
# They are deliberately different hosts in docker — see the gateway config docs.
OIDC_ISSUER=http://localhost:8088/realms/booking
OIDC_JWKS_URL=http://keycloak:8080/realms/booking/protocol/openid-connect/certs
OIDC_CLOCK_SKEW=30s
RATE_LIMIT_RPS=50
RATE_LIMIT_BURST=100

# --- Vault (dev mode) ---
VAULT_DEV_ROOT_TOKEN_ID=root_dev_token
VAULT_ADDR=http://vault:8200

# --- Observability (ADR-0013) ---
# Where each service exports its spans. LEAVE EMPTY for the inner loop: spans are still recorded,
# so trace_id/span_id appear in the logs (the log->trace contract) and services boot with no
# collector running. Set it to the collector to ship traces to Tempo/Grafana. It is an OTLP/gRPC
# endpoint (port 4317, NOT the 4318 HTTP receiver): the exporter speaks gRPC. A bare host:port is
# treated as insecure; an https:// URL enables TLS.
#   export -> OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317
OTEL_EXPORTER_OTLP_ENDPOINT=
# NOTE: the service name is set by each service from its own config (config.ServiceName), not from
# OTEL_SERVICE_NAME — that variable is intentionally not read.

# --- Mailhog (dev email sink) ---
SMTP_HOST=mailhog
SMTP_PORT=1025

# --- Payment (Stripe test mode — use test keys only) ---
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me

# --- Booking domain config ---
BOOKING_HOLD_TTL_SECONDS=900
